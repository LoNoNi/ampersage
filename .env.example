# .env.example - Variables d'environnement de l'application
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env dans le dépôt Git.

# ─── Enedis ───────────────────────────────────────────────────────────────────

# Token d'accès à l'API Enedis (obtenu via https://datahub-enedis.fr)
ENEDIS_TOKEN=

# Numéro de PDL (Point De Livraison) à 14 chiffres
ENEDIS_PDL=

# URL de base de l'API Enedis (ne pas modifier sauf environnement de recette)
ENEDIS_API_URL=https://api.enedis.fr

# ─── Serveur ──────────────────────────────────────────────────────────────────

# Port d'écoute du serveur Flask (défaut : 8080)
PORT=8080

# Niveau de log : DEBUG, INFO, WARNING, ERROR (défaut : INFO)
LOG_LEVEL=INFO
